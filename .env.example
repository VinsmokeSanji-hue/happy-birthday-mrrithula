# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CLOUD STORAGE CONFIGURATION
# 1. Project URL from Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Supabase Service Role Key (Settings -> API -> service_role secret)
# Stored securely on the backend / Render environment. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 3. Supabase Storage Bucket name (default: birthday-photos)
SUPABASE_BUCKET="birthday-photos"
